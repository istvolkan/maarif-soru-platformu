@page "/questions/book/{BookId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using MaarifPlatform.Infrastructure.Analysis
@using MaarifPlatform.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory

<PageTitle>@(_bookTitle ?? "Sorular")</PageTitle>

@if (_bookTitle is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <h1 class="page-title">@_bookTitle — Sorular</h1>

    @if (_questions is null || _questions.Count == 0)
    {
        <p>Bu kitap için henüz çıkarılmış soru yok. <a href="admin/books">Kitaplar</a> sayfasından "Soruları Çıkar"ı çalıştırın.</p>
    }
    else
    {
        <AuthorizeView Roles="Admin,Editor" Context="editorContext">
            <div class="card batch-card">
                <div class="actions">
                    <button disabled="@_batchRunning" @onclick="RunBatchTransformAsync">
                        @(_batchRunning ? "Dönüştürülüyor..." : "Tümünü Dönüştür")
                    </button>
                    <a class="btn btn-secondary" href="@($"/export/book/{BookId}/pdf")" target="_blank">PDF Oluştur / İndir</a>
                </div>

                @if (_batchRunning || _batchDone is not null)
                {
                    <p class="batch-progress">
                        İşlendi: @_batchProcessed / @_batchTotal
                        — Başarılı: @_batchSucceeded
                        — İncelemeli: @_batchNeedsReview
                        — Reddedildi: @_batchRejected
                        — Hatalı: @_batchFailed
                        — Zaten Tamamdı: @_batchAlreadyDone
                    </p>
                    @if (_batchErrors.Count > 0)
                    {
                        <ul class="batch-errors">
                            @foreach (var err in _batchErrors)
                            {
                                <li>Soru #@err.QuestionNo: @err.Message</li>
                            }
                        </ul>
                    }
                }
            </div>
        </AuthorizeView>

        <table>
            <thead><tr><th>#</th><th>Soru</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @foreach (var q in _questions)
                {
                    <tr>
                        <td>@q.QuestionNo</td>
                        <td>@Truncate(q.OriginalQuestion)</td>
                        <td><span class="status status-@q.Status.ToLowerInvariant()">@q.Status</span></td>
                        <td><a href="@($"questions/{q.Id}")">Detay</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<style>
    table { margin-top: 1rem; }
    .batch-card { margin-bottom: 1.25rem; }
    .batch-progress { margin-top: 0.75rem; font-size: 0.92rem; color: var(--z-muted); }
    .batch-errors { margin-top: 0.5rem; color: var(--z-danger); font-size: 0.88rem; }
</style>

@code {
    [Parameter]
    public Guid BookId { get; set; }

    private string? _bookTitle;
    private List<QuestionRow>? _questions;

    private bool _batchRunning;
    private bool? _batchDone;
    private int _batchTotal;
    private int _batchProcessed;
    private int _batchSucceeded;
    private int _batchNeedsReview;
    private int _batchRejected;
    private int _batchFailed;
    private int _batchAlreadyDone;
    private List<BatchQuestionResult> _batchErrors = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<MaarifDbContext>();

        _bookTitle = (await db.Books.Where(b => b.Id == BookId).Select(b => b.Title).FirstOrDefaultAsync()) ?? "Kitap bulunamadı";

        _questions = await db.Questions
            .Where(q => q.BookId == BookId)
            .OrderBy(q => q.QuestionNo)
            .Select(q => new QuestionRow(q.Id, q.QuestionNo,
                db.QuestionDnas
                    .Where(d => d.QuestionVersion!.QuestionId == q.Id)
                    .OrderByDescending(d => d.CreatedAt)
                    .Select(d => d.OriginalQuestion)
                    .FirstOrDefault(),
                q.Status.ToString()))
            .ToListAsync();
    }

    private async Task RunBatchTransformAsync()
    {
        _batchRunning = true;
        _batchDone = false;
        _batchTotal = _questions?.Count ?? 0;
        _batchProcessed = 0;
        _batchSucceeded = 0;
        _batchNeedsReview = 0;
        _batchRejected = 0;
        _batchFailed = 0;
        _batchAlreadyDone = 0;
        _batchErrors = new List<BatchQuestionResult>();
        StateHasChanged();

        await using var scope = ScopeFactory.CreateAsyncScope();
        var batchService = scope.ServiceProvider.GetRequiredService<BookBatchTransformService>();

        await foreach (var result in batchService.TransformBookAsync(BookId))
        {
            _batchProcessed++;
            switch (result.Outcome)
            {
                case BatchQuestionOutcome.Succeeded: _batchSucceeded++; break;
                case BatchQuestionOutcome.NeedsReview: _batchNeedsReview++; break;
                case BatchQuestionOutcome.Rejected: _batchRejected++; break;
                case BatchQuestionOutcome.AlreadyDone: _batchAlreadyDone++; break;
                case BatchQuestionOutcome.Failed:
                    _batchFailed++;
                    _batchErrors.Add(result);
                    break;
            }
            StateHasChanged();
        }

        _batchRunning = false;
        _batchDone = true;
        await LoadAsync();
    }

    private static string Truncate(string? text) =>
        string.IsNullOrEmpty(text) ? "(metin yok)" : text.Length <= 100 ? text : text[..100] + "...";

    private sealed record QuestionRow(Guid Id, int? QuestionNo, string? OriginalQuestion, string Status);
}
