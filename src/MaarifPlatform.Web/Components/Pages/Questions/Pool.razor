@page "/questions/pool"
@rendermode InteractiveServer
@inject MaarifPlatform.Web.Security.OperationGuard Guard
@attribute [Authorize(Policy = "QuestionPoolAccess")]
@using System.Text.Json
@using MaarifPlatform.Application.Intelligence
@using MaarifPlatform.Domain.Entities
@using MaarifPlatform.Domain.Enums
@using MaarifPlatform.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Soru Havuzu</PageTitle>
<h1 class="page-title">Soru Havuzu</h1>
<p class="page-intro">
    AI tarafından üretilmiş ve gerçek çok-model doğrulama hattından (Curriculum Validator →
    Judge → Benzerlik Kontrolü) geçmiş sorular — yalnızca öğretmen "Onayla" dedikten sonra
    kalıcı olarak onaylanmış sayılır.
</p>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
@if (_message is not null)
{
    <p class="ok">@_message</p>
}

@if (_questions is null)
{
    <p>Yükleniyor...</p>
}
else if (_questions.Count == 0)
{
    <p>Havuzda incelenecek soru yok. <a href="questions/generate">Soru Üret</a>'ten yeni sorular oluşturabilirsiniz.</p>
}
else
{
    <div class="pool-toolbar">
        <div class="actions">
            <button disabled="@_busy" @onclick="() => ApproveAllAsync(onlyMaarifAligned: true)">Yalnızca Maarif Uyumlu Olanları Onayla</button>
            <button disabled="@_busy" class="secondary" @onclick="() => ApproveAllAsync(onlyMaarifAligned: false)">Tümünü Onayla</button>
        </div>
        <p class="page-intro pool-toolbar-note">
            "Tümünü Onayla" Maarif Modeli uyumu düşük soruları da (@_questions.Count(q => q.PoolClassification != QuestionPoolClassification.MaarifAligned) adet) onaylar —
            bunlar atılmaz, yalnızca uyum puanı daha düşüktür.
        </p>
    </div>

    @foreach (var q in _questions)
    {
        <div class="card pool-card">
            <div class="pool-question">
                @q.QuestionText
                @if (q.MaarifAlignmentScore is int score)
                {
                    // 2026-10 kullanıcı kararı: "Yeşil M" / "Kırmızı M" ikonu — Hybrid/Traditional
                    // görsel olarak TEK bir "uyumlu değil" (kırmızı) durumuna indirgenir, ama
                    // başlıkta (title) tam bant + sayısal puan hâlâ görünür (detay isteyen için).
                    <span class="pool-alignment-icon @(IsMaarifAligned(q.PoolClassification) ? "pool-alignment-icon-aligned" : "pool-alignment-icon-low")"
                          title="@($"{AlignmentBadgeLabel(q.PoolClassification)} ({score}/100)")">
                        M
                    </span>
                }
            </div>

            @if (q.HasVisual)
            {
                <img class="pool-visual" src="@($"/media/question/{q.Id}/visual")" alt="Soru görseli" />
            }

            @if (q.Options.Count > 0)
            {
                <ul class="pool-options">
                    @foreach (var opt in q.Options)
                    {
                        <li class="@(opt.Label == q.CorrectLabel ? "correct" : "")">@opt.Label) @opt.Text</li>
                    }
                </ul>
            }

            <div class="pool-meta">
                @(q.Grade). Sınıf • @q.Subject
                @if (!string.IsNullOrEmpty(q.LearningOutcomeCode)) { <span> • @q.LearningOutcomeCode</span> }
                @if (!string.IsNullOrEmpty(q.Skill)) { <span> • @q.Skill</span> }
                @if (!string.IsNullOrEmpty(q.Difficulty)) { <span> • @q.Difficulty</span> }
            </div>

            @if (_expanded.Contains(q.Id))
            {
                <div class="pool-solution">
                    <p><strong>Çözüm:</strong> @(q.Solution ?? "-")</p>
                    @if (q.Distractors.Count > 0)
                    {
                        <p><strong>Çeldirici / Kavram Yanılgısı Analizi:</strong></p>
                        <ul>
                            @foreach (var d in q.Distractors)
                            {
                                <li>@d.OptionLabel — @(d.MisconceptionCode ?? "genel") @(string.IsNullOrEmpty(d.Explanation) ? "" : $": {d.Explanation}")</li>
                            }
                        </ul>
                    }
                </div>
            }

            @if (_confirmingLowAlignment.Contains(q.Id))
            {
                <p class="warning pool-alignment-warning">
                    Bu sorunun Maarif Modeli uyum puanı düşük (@q.MaarifAlignmentScore/100) — yine de onaylamak istediğinize emin misiniz?
                </p>
            }

            <div class="actions">
                <button class="secondary" @onclick="() => ToggleSolution(q.Id)">
                    @(_expanded.Contains(q.Id) ? "Çözümü Gizle" : "Çözümü Gör")
                </button>
                @if (_confirmingLowAlignment.Contains(q.Id))
                {
                    <button disabled="@_busy" @onclick="() => ApproveAsync(q.Id, confirmedLowAlignment: true)">Yine de Onayla</button>
                    <button disabled="@_busy" class="secondary" @onclick="() => _confirmingLowAlignment.Remove(q.Id)">Vazgeç</button>
                }
                else
                {
                    <button disabled="@_busy" @onclick="() => ApproveAsync(q.Id)">Onayla</button>
                }
                <button disabled="@_busy" class="secondary" @onclick="() => RejectAsync(q.Id)">Reddet</button>
                <a class="btn btn-secondary" href="@($"questions/{q.Id}")">Detay</a>
            </div>
        </div>
    }
}

<style>
    .pool-toolbar { margin-bottom: 1.25rem; }
    .pool-card { margin-bottom: 1.25rem; }
    .pool-question { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.75rem; }
    .pool-visual { max-width: 100%; border: 1px solid var(--z-border, #ddd); border-radius: var(--z-radius); margin-bottom: 0.75rem; }
    .pool-options { list-style: none; margin: 0 0 0.75rem 0; padding: 0; }
    .pool-options li { padding: 0.25rem 0; }
    .pool-options li.correct { font-weight: 700; color: var(--z-success); }
    .pool-meta { font-size: 0.85rem; color: var(--z-muted); margin-bottom: 0.75rem; }
    .pool-solution { background: var(--z-bg, #f7f7f7); border-radius: var(--z-radius); padding: 0.75rem 1rem; margin-bottom: 0.75rem; font-size: 0.92rem; }
    .pool-toolbar-note { font-size: 0.82rem; margin: 0.4rem 0 0 0; }
    .pool-alignment-icon {
        display: inline-flex; align-items: center; justify-content: center;
        width: 1.4rem; height: 1.4rem; margin-left: 0.5rem; border-radius: 50%;
        font-size: 0.85rem; font-weight: 800; vertical-align: middle; cursor: help;
    }
    .pool-alignment-icon-aligned { background: #e6f4ea; color: #1e7a34; border: 1.5px solid #1e7a34; }
    .pool-alignment-icon-low { background: #fde8e8; color: #b42318; border: 1.5px solid #b42318; }
    .pool-alignment-warning { color: #b42318; font-weight: 600; }
</style>

@code {
    private List<PoolQuestionRow>? _questions;
    private readonly HashSet<Guid> _expanded = new();
    private readonly HashSet<Guid> _confirmingLowAlignment = new();
    private bool _busy;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await Guard.RequireAsync("QuestionPoolAccess");
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<MaarifDbContext>();

        var rows = await db.Questions
            .Where(q => q.Book!.SourceType == SourceType.Generated && q.Status == QuestionStatus.AiApproved)
            .OrderByDescending(q => q.UpdatedAt)
            .Select(q => new
            {
                q.Id,
                Dna = db.QuestionDnas
                    .Where(d => d.QuestionVersion!.QuestionId == q.Id)
                    .OrderByDescending(d => d.CreatedAt)
                    .FirstOrDefault(),
                VersionId = db.QuestionVersions
                    .Where(v => v.QuestionId == q.Id)
                    .OrderByDescending(v => v.VersionNo)
                    .Select(v => v.Id)
                    .FirstOrDefault()
            })
            .ToListAsync();

        _questions = new List<PoolQuestionRow>();
        foreach (var row in rows)
        {
            if (row.Dna is null)
            {
                continue;
            }

            var options = string.IsNullOrWhiteSpace(row.Dna.OriginalOptionsJson)
                ? new List<OptionCandidate>()
                : JsonSerializer.Deserialize<List<OptionCandidate>>(row.Dna.OriginalOptionsJson!) ?? new();

            var correctLabel = options.FirstOrDefault(o => o.Text == row.Dna.CorrectAnswer)?.Label;

            var distractors = await db.Distractors
                .Where(d => d.QuestionVersionId == row.VersionId)
                .Select(d => new DistractorRow(d.OptionLabel, d.MisconceptionCode, d.Explanation))
                .ToListAsync();

            _questions.Add(new PoolQuestionRow(
                row.Id, row.Dna.OriginalQuestion ?? "(soru metni yok)",
                options.Select(o => (o.Label, o.Text)).ToList(), correctLabel,
                row.Dna.Solution, row.Dna.Grade ?? 0, row.Dna.Subject ?? "-",
                row.Dna.LearningOutcomeCode, row.Dna.FieldSkill, row.Dna.Difficulty?.ToString(),
                distractors, row.Dna.RequiresVisual, row.Dna.MaarifAlignmentScore, row.Dna.PoolClassification));
        }
    }

    private void ToggleSolution(Guid questionId)
    {
        if (!_expanded.Add(questionId))
        {
            _expanded.Remove(questionId);
        }
    }

    // 2026-10 kullanıcı kararı: Maarif Modeli uyumu düşük bir soru onaylanmak istendiğinde
    // sessizce onaylanmaz — önce bir uyarı gösterilir, yönetici "Yine de Onayla"ya BİLEREK
    // tekrar basmalıdır. Hiçbir soru bu yüzden engellenmiyor, yalnızca bilinçli bir ikinci adım.
    private async Task ApproveAsync(Guid questionId, bool confirmedLowAlignment = false)
    {
        var question = _questions!.First(q => q.Id == questionId);
        var isLowAlignment = question.PoolClassification is not null && question.PoolClassification != QuestionPoolClassification.MaarifAligned;

        if (isLowAlignment && !confirmedLowAlignment)
        {
            _confirmingLowAlignment.Add(questionId);
            return;
        }

        _confirmingLowAlignment.Remove(questionId);
        await SetStatusAsync(questionId, QuestionStatus.EditorApproved);
    }

    private async Task RejectAsync(Guid questionId)
    {
        _confirmingLowAlignment.Remove(questionId);
        await SetStatusAsync(questionId, QuestionStatus.Rejected);
    }

    /// <summary>2026-10 kullanıcı kararı — bkz. GeneratedBookNaming doc'u. DİKKAT: bu kitabı aynı
    /// SaveChangesAsync çağrısından önce birden fazla kez oluşturmak İSTEMEDEN YİNELENEN kitaplar
    /// doğurur (kaydedilmemiş Add'ler yeni bir db sorgusuna yansımaz) — çağıran taraf aynı
    /// (Grade,Subject) için BİR KEZ çağırıp sonucu önbelleğe almalıdır (bkz. ApproveAllAsync).</summary>
    private static async Task<Guid> GetOrCreateMaarifAlignedBookIdAsync(MaarifDbContext db, int grade, string subject)
    {
        var title = GeneratedBookNaming.MaarifAlignedTitle(grade, subject);
        var existing = await db.Books.FirstOrDefaultAsync(b => b.Title == title && b.SourceType == SourceType.Generated);
        if (existing is not null)
        {
            return existing.Id;
        }

        var book = new Book
        {
            Title = title, Grade = grade, Subject = subject,
            SourceType = SourceType.Generated, StorageUri = string.Empty
        };
        db.Books.Add(book);
        return book.Id;
    }

    private static bool IsMaarifAligned(QuestionPoolClassification? classification) =>
        classification == QuestionPoolClassification.MaarifAligned;

    private static string AlignmentBadgeLabel(QuestionPoolClassification? classification) => classification switch
    {
        QuestionPoolClassification.MaarifAligned => "Maarif Uyumlu",
        QuestionPoolClassification.Hybrid => "Kısmi Uyum",
        QuestionPoolClassification.Traditional => "Düşük Uyum",
        _ => "-"
    };

    private async Task SetStatusAsync(Guid questionId, QuestionStatus status)
    {
        await Guard.RequireAsync("QuestionEdit");
        _busy = true;
        _error = null;
        _message = null;
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<MaarifDbContext>();

        try
        {
            var question = await db.Questions.FirstAsync(q => q.Id == questionId);
            question.Status = status;
            question.UpdatedAt = DateTimeOffset.UtcNow;

            // 2026-10 kullanıcı kararı: onaylanan Maarif Uyumlu bir soru, ayrı bir "Maarif Uyumlu
            // AI Soruları" kitapçığına TAŞINIR (BookId değiştirilir) — böylece bu kitap zaten var
            // olan BookPdfExportService ile AYRI bir PDF olarak dışa aktarılabilir. Uyumlu OLMAYAN
            // onaylı sorular genel havuz kitabında KALIR (taşınmaz) — yalnızca Maarif Uyumlu'nun
            // kendi kitapçığı var, bu özelliğin istendiği gibi.
            var row = _questions!.FirstOrDefault(q => q.Id == questionId);
            if (status == QuestionStatus.EditorApproved && row is not null && IsMaarifAligned(row.PoolClassification))
            {
                question.BookId = await GetOrCreateMaarifAlignedBookIdAsync(db, row.Grade, row.Subject);
            }

            await db.SaveChangesAsync();
            _message = status == QuestionStatus.EditorApproved ? "Soru onaylandı." : "Soru reddedildi.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private async Task ApproveAllAsync(bool onlyMaarifAligned)
    {
        await Guard.RequireAsync("QuestionEdit");
        _busy = true;
        _error = null;
        _message = null;
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<MaarifDbContext>();

        try
        {
            var rows = onlyMaarifAligned
                ? _questions!.Where(q => q.PoolClassification == QuestionPoolClassification.MaarifAligned).ToList()
                : _questions!;
            var ids = rows.Select(q => q.Id).ToList();
            var questions = await db.Questions.Where(q => ids.Contains(q.Id)).ToListAsync();

            // Aynı (Grade,Subject) kombinasyonu bu döngüde birden fazla kez geçebileceği için
            // (bkz. GetOrCreateMaarifAlignedBookIdAsync doc'u — kaydedilmemiş Add'ler yeni bir
            // sorguya YANSIMAZ) kitap id'si BİR KEZ çözülüp burada önbelleğe alınır, aksi halde
            // aynı sınıf/ders için birden fazla yinelenen "Maarif Uyumlu" kitabı oluşurdu.
            var maarifBookIdCache = new Dictionary<(int Grade, string Subject), Guid>();
            foreach (var question in questions)
            {
                question.Status = QuestionStatus.EditorApproved;
                question.UpdatedAt = DateTimeOffset.UtcNow;

                var row = rows.First(q => q.Id == question.Id);
                if (IsMaarifAligned(row.PoolClassification))
                {
                    var key = (row.Grade, row.Subject);
                    if (!maarifBookIdCache.TryGetValue(key, out var bookId))
                    {
                        bookId = await GetOrCreateMaarifAlignedBookIdAsync(db, row.Grade, row.Subject);
                        maarifBookIdCache[key] = bookId;
                    }
                    question.BookId = bookId;
                }
            }
            await db.SaveChangesAsync();
            _message = questions.Count == 0
                ? "Onaylanacak soru bulunamadı."
                : $"{questions.Count} soru onaylandı.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private sealed record OptionCandidate(string Label, string Text);
    private sealed record DistractorRow(string OptionLabel, string? MisconceptionCode, string? Explanation);
    private sealed record PoolQuestionRow(
        Guid Id, string QuestionText, List<(string Label, string Text)> Options, string? CorrectLabel,
        string? Solution, int Grade, string Subject, string? LearningOutcomeCode, string? Skill,
        string? Difficulty, List<DistractorRow> Distractors, bool HasVisual,
        int? MaarifAlignmentScore, QuestionPoolClassification? PoolClassification);
}
