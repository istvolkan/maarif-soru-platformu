@page "/admin/books"
@rendermode InteractiveServer
@inject MaarifPlatform.Web.Security.OperationGuard Guard
@attribute [Authorize(Roles = "Admin")]
@using MaarifPlatform.Application.Storage
@using MaarifPlatform.Infrastructure.Curriculum
@using MaarifPlatform.Infrastructure.Extraction
@using MaarifPlatform.Infrastructure.Persistence
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Kitaplar</PageTitle>
<h1 class="page-title">Kitaplar</h1>
<p class="page-intro">
    Maarif model ders kitaplarını buradan yükleyin — yükledikten sonra "Soruları Çıkar" ile PDF'ten
    soru bloklarını çıkarabilirsiniz. Matematiksel gösterim (kesir/üs) veya diyagram içeren sayfalar
    otomatik olarak tespit edilip bir Vision modeliyle yeniden okunur — hangi sayfanın buna ihtiyacı
    olduğuna sistem kendi karar verir.
</p>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

<div class="card">
    <EditForm Model="_form" OnValidSubmit="UploadAsync">
        <DataAnnotationsValidator />
        <div class="field"><label>Başlık</label><InputText @bind-Value="_form.Title" /></div>
        <div class="field">
            <label>Sınıf</label>
            <InputSelect @bind-Value="_form.Grade" @bind-Value:after="OnGradeChanged">
                <option value="">— seçin —</option>
                @foreach (var g in NationalCurriculumCatalog.Grades)
                {
                    <option value="@g">@g. Sınıf</option>
                }
            </InputSelect>
        </div>
        <div class="field">
            <label>Ders</label>
            <InputSelect @bind-Value="_form.Subject">
                <option value="">— seçin —</option>
                @foreach (var s in _subjects)
                {
                    <option value="@s">@s</option>
                }
            </InputSelect>
        </div>
        <div class="field">
            <label>Yayınevi</label>
            <InputSelect @bind-Value="_form.PublisherSelection">
                @foreach (var p in _publishers)
                {
                    <option value="@p">@p</option>
                }
                <option value="@OtherPublisherValue">— Yeni Ekle —</option>
            </InputSelect>
            @if (_form.PublisherSelection == OtherPublisherValue)
            {
                <InputText @bind-Value="_form.PublisherOther" placeholder="Yeni yayınevi adı" />
            }
        </div>
        <div class="field">
            <label>Yazar (opsiyonel)</label>
            <InputText @bind-Value="_form.AuthorName" placeholder="Belirtmek istemiyorsanız boş bırakın" />
        </div>
        <div class="field"><label>PDF Dosyası</label><InputFile OnChange="OnFileSelected" accept=".pdf" /></div>
        <button type="submit" disabled="@(_selectedFile is null || _uploading)">@(_uploading ? "Yükleniyor..." : "Yükle")</button>
    </EditForm>
</div>

@if (_books is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <table>
        <thead>
            <tr><th>Başlık</th><th>Sınıf</th><th>Ders</th><th>Kaynak</th><th>Sayfa</th><th>Soru</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var b in _books)
            {
                <tr>
                    <td>@b.Title</td>
                    <td>@b.Grade</td>
                    <td>@b.Subject</td>
                    <td>@b.SourceType</td>
                    <td>@b.TotalPages</td>
                    <td><a href="@($"questions/book/{b.Id}")">@b.QuestionCount soru</a></td>
                    <td>
                        @if (b.TotalPages is null)
                        {
                            <button disabled="@(_extractingId == b.Id)" @onclick="() => ExtractAsync(b.Id)">
                                @(_extractingId == b.Id ? "Çıkarılıyor..." : "Soruları Çıkar")
                            </button>
                        }
                        <button class="secondary" disabled="@(_deletingId == b.Id)" @onclick="() => DeleteAsync(b.Id)">
                            @(_deletingId == b.Id ? "Siliniyor..." : "Sil")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // §16 Kitaplar formu: "MEB muhakkak listede olsun" — DB'de hiç kitap yokken bile Yayınevi
    // listesi boş kalmasın diye MEB, mevcut kitaplardan çekilen distinct yayınevlerinin
    // ÖNÜNE sabit olarak eklenir (ReferenceDocuments.razor'daki KnownAuthorities/
    // OtherAuthorityValue "listede yoksa yeni ekle" deseniyle AYNI mantık).
    private const string OtherPublisherValue = "__yeni__";

    private BookForm _form = new();
    private IBrowserFile? _selectedFile;
    private bool _uploading;
    private string? _error;
    private Guid? _deletingId;
    private Guid? _extractingId;
    private List<BookRow>? _books;
    private List<string> _subjects = new();
    private List<string> _publishers = new() { "MEB" };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void OnGradeChanged()
    {
        _form.Subject = string.Empty;
        _subjects = _form.Grade is null ? new() : NationalCurriculumCatalog.GetCoursesForGrade(_form.Grade.Value).ToList();
    }

    private async Task LoadAsync()
    {
        await Guard.RequireAsync("AdminOnly");
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<MaarifDbContext>();

        _books = await db.Books
            .OrderByDescending(b => b.CreatedAt)
            .Select(b => new BookRow(b.Id, b.Title, b.Grade, b.Subject, b.SourceType.ToString(), b.TotalPages,
                db.Questions.Count(q => q.BookId == b.Id)))
            .ToListAsync();

        var existingPublishers = await db.Books
            .Where(b => b.Publisher != null && b.Publisher != "")
            .Select(b => b.Publisher!)
            .Distinct()
            .ToListAsync();

        _publishers = new List<string> { "MEB" }
            .Concat(existingPublishers
                .Where(p => !string.Equals(p, "MEB", StringComparison.OrdinalIgnoreCase))
                .OrderBy(p => p, StringComparer.CurrentCultureIgnoreCase))
            .ToList();
    }

    private void OnFileSelected(InputFileChangeEventArgs e) => _selectedFile = e.File;

    private async Task UploadAsync()
    {
        await Guard.RequireAsync("AdminOnly");
        if (_selectedFile is null)
        {
            return;
        }

        if (_form.PublisherSelection == OtherPublisherValue && string.IsNullOrWhiteSpace(_form.PublisherOther))
        {
            _error = "Yeni yayınevi adı boş olamaz.";
            return;
        }

        _uploading = true;
        _error = null;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<MaarifDbContext>();
            var storage = scope.ServiceProvider.GetRequiredService<IBookFileStorage>();

            var publisher = _form.PublisherSelection == OtherPublisherValue ? _form.PublisherOther : _form.PublisherSelection;
            var book = new Book
            {
                Title = _form.Title, Grade = _form.Grade, Subject = _form.Subject, Publisher = publisher,
                AuthorName = string.IsNullOrWhiteSpace(_form.AuthorName) ? null : _form.AuthorName.Trim()
            };

            await using (var stream = _selectedFile.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024))
            {
                book.StorageUri = await storage.SaveAsync(book.Id, _selectedFile.Name, stream);
            }

            db.Books.Add(book);
            await db.SaveChangesAsync();

            _form = new();
            _subjects = new();
            _selectedFile = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task DeleteAsync(Guid bookId)
    {
        await Guard.RequireAsync("AdminOnly");
        _error = null;
        _deletingId = bookId;
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<MaarifDbContext>();

        try
        {
            // Book -> Questions FK'i Restrict'tir (bkz. BookConfiguration) — önce sorular
            // silinmeli, ardından Book silinebilir (BookPages Book silinince otomatik Cascade olur).
            var questions = await db.Questions.Where(q => q.BookId == bookId).ToListAsync();
            db.Questions.RemoveRange(questions);
            await db.SaveChangesAsync();

            var book = await db.Books.FirstOrDefaultAsync(b => b.Id == bookId);
            if (book is not null)
            {
                db.Books.Remove(book);
                await db.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _deletingId = null;
        }

        await LoadAsync();
    }

    private async Task ExtractAsync(Guid bookId)
    {
        await Guard.RequireAsync("AdminOnly");
        _error = null;
        _extractingId = bookId;
        await using var scope = ScopeFactory.CreateAsyncScope();
        var extractionService = scope.ServiceProvider.GetRequiredService<BookExtractionService>();

        try
        {
            await extractionService.ExtractAsync(bookId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _extractingId = null;
        }

        await LoadAsync();
    }

    private sealed class BookForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Title { get; set; } = string.Empty;
        public int? Grade { get; set; }
        [System.ComponentModel.DataAnnotations.Required]
        public string Subject { get; set; } = string.Empty;
        public string PublisherSelection { get; set; } = "MEB";
        public string? PublisherOther { get; set; }
        public string? AuthorName { get; set; }
    }

    private sealed record BookRow(Guid Id, string Title, int? Grade, string Subject, string SourceType, int? TotalPages, int QuestionCount);
}
