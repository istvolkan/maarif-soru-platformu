@page "/admin/reference-documents"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using System.Security.Cryptography
@using MaarifPlatform.Application.Storage
@using MaarifPlatform.Infrastructure.Curriculum
@using MaarifPlatform.Infrastructure.Persistence
@using MaarifPlatform.Infrastructure.Rag
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Referans Dokümanları</PageTitle>
<h1 class="page-title">Referans Dokümanları</h1>
<p class="page-intro">
    MEB öğretim programı/kılavuz gibi RAG kaynak dokümanları buraya yüklenir. Bir kitaptaki
    sorular, ancak aynı Sınıf/Ders için ingest edilmiş bir referans doküman varsa RAG grounding
    alabilir — grounding olmadan Analyze her zaman "İncelemeye Gönder" durumuna düşer.
</p>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
@if (_extractionInfo is not null)
{
    <p class="ok">@_extractionInfo <a href="admin/curriculum-review">Müfredat Onayı'nda incele →</a></p>
}

<div class="card">
    <EditForm Model="_form" OnValidSubmit="UploadAsync">
        <DataAnnotationsValidator />
        <div class="field"><label>Başlık</label><InputText @bind-Value="_form.Title" /></div>
        <div class="field">
            <label>Doküman Türü</label>
            <InputSelect @bind-Value="_form.DocumentType">
                <option value="">— seçin —</option>
                @foreach (var dt in NationalCurriculumCatalog.DocumentTypes)
                {
                    <option value="@dt.Value">@dt.Label</option>
                }
            </InputSelect>
        </div>
        <div class="field">
            <label>Sınıf</label>
            <InputSelect @bind-Value="_form.Grade" @bind-Value:after="OnFormGradeChangedAsync">
                <option value="">— seçin —</option>
                @foreach (var g in NationalCurriculumCatalog.Grades)
                {
                    <option value="@g">@g. Sınıf</option>
                }
            </InputSelect>
        </div>
        <div class="field">
            <label>Ders</label>
            <InputSelect @bind-Value="_form.Subject">
                <option value="">— seçin —</option>
                @foreach (var s in _formCourses)
                {
                    <option value="@s">@s</option>
                }
            </InputSelect>
        </div>
        <div class="field">
            <label>Yetkili Kurum</label>
            <InputSelect @bind-Value="_form.AuthoritySelection">
                @foreach (var a in NationalCurriculumCatalog.KnownAuthorities)
                {
                    <option value="@a">@a</option>
                }
                <option value="@NationalCurriculumCatalog.OtherAuthorityValue">Diğer (elle gir)</option>
            </InputSelect>
            @if (_form.AuthoritySelection == NationalCurriculumCatalog.OtherAuthorityValue)
            {
                <InputText @bind-Value="_form.AuthorityOther" placeholder="Kurum adını yazın" />
            }
        </div>
        <div class="field"><label>PDF Dosyası</label><InputFile OnChange="OnFileSelected" accept=".pdf" /></div>
        <button type="submit" disabled="@(_selectedFile is null || _uploading)">@(_uploading ? "Yükleniyor..." : "Yükle")</button>
    </EditForm>
</div>

@if (_documents is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <table>
        <thead>
            <tr><th>Başlık</th><th>Tür</th><th>Sınıf</th><th>Ders</th><th>Chunk</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var d in _documents)
            {
                <tr>
                    <td>@d.Title</td>
                    <td>@d.DocumentType</td>
                    <td>@d.Grade</td>
                    <td>@d.Subject</td>
                    <td>@d.ChunkCount</td>
                    <td>
                        @if (d.ChunkCount == 0)
                        {
                            <button @onclick="() => IngestAsync(d.Id)">Ingest Et</button>
                        }
                        else if (d.Grade is not null)
                        {
                            @if (d.ExtractedThemeCount > 0)
                            {
                                <span class="extracted-badge">✓ Çıkarıldı (@d.ExtractedThemeCount tema)</span>
                            }
                            <button class="@(d.ExtractedThemeCount > 0 ? "secondary" : "")"
                                    disabled="@(_extractingId == d.Id)" @onclick="() => ExtractCurriculumAsync(d.Id)">
                                @(_extractingId == d.Id ? "Çıkarılıyor..." : d.ExtractedThemeCount > 0 ? "Tekrar Çıkar" : "Müfredat Yapısını Çıkar")
                            </button>
                        }
                        <button class="secondary" disabled="@(_deletingId == d.Id)" @onclick="() => DeleteDocumentAsync(d.Id)">
                            @(_deletingId == d.Id ? "Siliniyor..." : "Sil")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<style>
    .extracted-badge {
        display: inline-block;
        color: var(--z-success, #1a7f37);
        font-size: 0.85rem;
        font-weight: 600;
        margin-right: 0.5rem;
        white-space: nowrap;
    }
</style>

@code {
    private DocumentForm _form = new();
    private List<string> _formCourses = new();
    private IBrowserFile? _selectedFile;
    private bool _uploading;
    private string? _error;
    private string? _extractionInfo;
    private Guid? _extractingId;
    private Guid? _deletingId;
    private List<DocumentRow>? _documents;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private Task OnFormGradeChangedAsync()
    {
        _form.Subject = string.Empty;
        _formCourses = _form.Grade is null
            ? new()
            : NationalCurriculumCatalog.GetCoursesForGrade(_form.Grade.Value).ToList();
        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<MaarifDbContext>();

        _documents = await db.ReferenceDocuments
            .OrderByDescending(d => d.CreatedAt)
            .Select(d => new DocumentRow(d.Id, d.Title, d.DocumentType, d.Grade, d.Subject,
                db.ReferenceChunks.Count(c => c.ReferenceDocumentId == d.Id),
                db.Themes.Count(t => t.SourceDocumentId == d.Id)))
            .ToListAsync();
    }

    private void OnFileSelected(InputFileChangeEventArgs e) => _selectedFile = e.File;

    private async Task UploadAsync()
    {
        if (_selectedFile is null)
        {
            return;
        }

        _uploading = true;
        _error = null;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<MaarifDbContext>();
            var storage = scope.ServiceProvider.GetRequiredService<IBookFileStorage>();

            byte[] fileBytes;
            await using (var buffer = new MemoryStream())
            {
                await using var readStream = _selectedFile.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024);
                await readStream.CopyToAsync(buffer);
                fileBytes = buffer.ToArray();
            }

            // §9: aynı dokümanın tekrar tekrar yüklenip gömülmesini önlemek için içerik hash'i —
            // ReferenceDocumentsController.Create ile aynı deterministik kural.
            var documentHash = Convert.ToHexString(SHA256.HashData(fileBytes));
            var existing = await db.ReferenceDocuments.FirstOrDefaultAsync(d => d.DocumentHash == documentHash);
            if (existing is not null)
            {
                _error = "Bu içerik daha önce yüklenmiş.";
                return;
            }

            var authority = _form.AuthoritySelection == NationalCurriculumCatalog.OtherAuthorityValue
                ? _form.AuthorityOther
                : _form.AuthoritySelection;
            if (string.IsNullOrWhiteSpace(authority))
            {
                _error = "Yetkili Kurum boş olamaz.";
                return;
            }

            var document = new ReferenceDocument
            {
                Title = _form.Title,
                DocumentType = _form.DocumentType,
                Grade = _form.Grade,
                Subject = _form.Subject,
                Authority = authority,
                DocumentHash = documentHash
            };

            await using (var stream = new MemoryStream(fileBytes))
            {
                document.StorageUri = await storage.SaveAsync(document.Id, _selectedFile.Name, stream);
            }

            db.ReferenceDocuments.Add(document);
            await db.SaveChangesAsync();

            _form = new();
            _formCourses = new();
            _selectedFile = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task IngestAsync(Guid documentId)
    {
        _error = null;
        await using var scope = ScopeFactory.CreateAsyncScope();
        var ingestionService = scope.ServiceProvider.GetRequiredService<ReferenceIngestionService>();

        try
        {
            await ingestionService.IngestAsync(documentId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        await LoadAsync();
    }

    private async Task ExtractCurriculumAsync(Guid documentId)
    {
        _error = null;
        _extractionInfo = null;
        _extractingId = documentId;

        await using var scope = ScopeFactory.CreateAsyncScope();
        var extractionService = scope.ServiceProvider.GetRequiredService<CurriculumExtractionService>();

        try
        {
            var result = await extractionService.ExtractAsync(documentId);
            _extractionInfo = $"Çıkarıldı (henüz Draft, onay bekliyor): {result.ThemesCreated} tema, " +
                $"{result.LearningOutcomesCreated} kazanım, {result.ContentFrameworksCreated} içerik çerçevesi, " +
                $"{result.ProcessComponentsCreated} süreç bileşeni, {result.FieldSkillsCreated} alan becerisi.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _extractingId = null;
        }

        await LoadAsync();
    }

    private async Task DeleteDocumentAsync(Guid documentId)
    {
        _error = null;
        _extractionInfo = null;
        _deletingId = documentId;

        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<MaarifDbContext>();

        try
        {
            // Curriculum tablolarının hepsi SourceDocument FK'inde Restrict kullanır (bkz.
            // Curriculum.cs/Assessment.cs) — kazara zincirleme silme yok, bu yüzden sırayı
            // elle yönetmemiz gerekiyor: önce yaprak kayıtlar (ContentFramework/ProcessComponent/
            // FieldSkill), sonra LearningOutcome, en son — yalnızca başka bir dokümandan gelen
            // kazanımı KALMAMIŞSA — Theme. ReferenceChunks, ReferenceDocument silinince Cascade
            // ile otomatik gider.
            await db.ContentFrameworks.Where(cf => cf.SourceDocumentId == documentId).ExecuteDeleteAsync();
            await db.ProcessComponents.Where(pc => pc.SourceDocumentId == documentId).ExecuteDeleteAsync();
            await db.FieldSkills.Where(fs => fs.SourceDocumentId == documentId).ExecuteDeleteAsync();
            await db.LearningOutcomes.Where(lo => lo.SourceDocumentId == documentId).ExecuteDeleteAsync();

            var themeIds = await db.Themes.Where(t => t.SourceDocumentId == documentId).Select(t => t.Id).ToListAsync();
            foreach (var themeId in themeIds)
            {
                var stillHasOutcomes = await db.LearningOutcomes.AnyAsync(lo => lo.ThemeId == themeId);
                if (!stillHasOutcomes)
                {
                    await db.Themes.Where(t => t.Id == themeId).ExecuteDeleteAsync();
                }
                else
                {
                    // Bu tema başka bir dokümandan gelen kazanımlarla hâlâ kullanılıyor (aynı
                    // Sınıf/Ders/isim eşleşmesiyle yeniden kullanılmıştı) — temayı SİLMEDEN,
                    // yalnızca kaynak referansını temizle (artık tek bir belgeye ait değil,
                    // karma/birleşik kaynaklı), yoksa ReferenceDocument silinemez.
                    await db.Themes.Where(t => t.Id == themeId)
                        .ExecuteUpdateAsync(s => s.SetProperty(t => t.SourceDocumentId, (Guid?)null));
                }
            }

            await db.ReferenceDocuments.Where(d => d.Id == documentId).ExecuteDeleteAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _deletingId = null;
        }

        await LoadAsync();
    }

    private sealed class DocumentForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Title { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required]
        public string DocumentType { get; set; } = string.Empty;
        public int? Grade { get; set; }
        [System.ComponentModel.DataAnnotations.Required]
        public string Subject { get; set; } = string.Empty;
        public string AuthoritySelection { get; set; } = NationalCurriculumCatalog.KnownAuthorities[0];
        public string? AuthorityOther { get; set; }
    }

    private sealed record DocumentRow(Guid Id, string Title, string DocumentType, int? Grade, string Subject, int ChunkCount, int ExtractedThemeCount);
}
